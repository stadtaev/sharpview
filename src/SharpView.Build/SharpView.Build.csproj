<Project Sdk="Microsoft.NET.Sdk">

  <!-- MSBuild package: <PackageReference Include="SharpView" /> runs the exceptions analysis after each build and reports
       its findings as build warnings. It carries no library: only build/SharpView.targets and a copy of the CLI. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>SharpView</PackageId>
    <!-- Makes NuGet add the reference with PrivateAssets="all", so the package never flows to dependent projects. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <HasOwnReadme>true</HasOwnReadme>
    <!-- NU5100: the CLI's assemblies live under tools/, not lib/, on purpose. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackCli</TargetsForTfmSpecificContentInPackage>
    <Description>Reports SharpView's exception findings as build warnings in dotnet build, Visual Studio and VS Code: exceptions that may escape a controller action (SV0001, SV0002 when a global exception handler catches them) and throws that pass through a try whose catches do not match (SV0003). Add it to the Web API project; the analysis runs after each build.</Description>
    <PackageTags>roslyn;static-analysis;aspnetcore;exceptions;msbuild;build-warnings</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Include="build/SharpView.targets" Pack="true" PackagePath="build/" />
    <!-- Only for build order; the CLI ships as files under tools/. -->
    <ProjectReference Include="../SharpView.Cli/SharpView.Cli.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The CLI's publish output, the same files the tool package ships. RemoveProperties keeps the call on the instance the
       solution build already built instead of a second one with TargetFramework set. -->
  <Target Name="PackCli">
    <MSBuild Projects="../SharpView.Cli/SharpView.Cli.csproj" Targets="Publish" RemoveProperties="TargetFramework" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="../SharpView.Cli/bin/$(Configuration)/net10.0/publish/**" Exclude="../SharpView.Cli/bin/$(Configuration)/net10.0/publish/**/*.pdb" PackagePath="tools/net10.0/%(RecursiveDir)" />
    </ItemGroup>
  </Target>

</Project>
